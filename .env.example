# Single-tenant overrides. Leave blank until the pixel exists.
# The page and the redirects work without these.
META_PIXEL_ID=
CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Replaces config/tenants.json entirely when set.
